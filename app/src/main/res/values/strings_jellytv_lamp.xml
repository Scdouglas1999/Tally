<resources>
    <!-- The tally light: launch card and live tune-in. Names are prefixed jtv_; never add these to strings.xml. -->

    <!-- The app's wordmark on the launch card. Not translated: it is the name. -->
    <string name="jtv_lamp_wordmark" translatable="false">TALLY</string>
    <!-- Under the wordmark when the server has not answered after a few seconds. %1$s = the server's name. -->
    <string name="jtv_lamp_connecting_to">CONNECTING TO %1$s…</string>
    <!-- Same, when the server's name is not known. -->
    <string name="jtv_lamp_connecting">CONNECTING…</string>
    <!-- Over a live channel while its picture is on its way. -->
    <string name="jtv_lamp_tuning_in">TUNING IN</string>
    <!-- The game on the channel being tuned in: %1$s = away team, %2$s = home team (e.g. "Rays at Yankees"). -->
    <string name="jtv_lamp_matchup">%1$s at %2$s</string>
</resources>
