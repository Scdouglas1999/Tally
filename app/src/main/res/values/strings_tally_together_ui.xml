<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Watch Together on screen: the party chip, its notices and the home row. Names are prefixed
         tally_together_ui_; never add these to strings.xml. Parties are called "watch parties" everywhere. -->

    <!-- The chip at the top right while this TV is in a watch party. -->
    <string name="tally_together_ui_chip">WATCH PARTY</string>
    <string name="tally_together_ui_watching">%1$d WATCHING</string>
    <string name="tally_together_ui_waiting">WAITING…</string>

    <!-- Notices under the chip. %1$s is a Jellyfin user name, drawn uppercase. -->
    <string name="tally_together_ui_joined">%1$s JOINED</string>
    <string name="tally_together_ui_left">%1$s LEFT</string>
    <string name="tally_together_ui_notice_waiting">WAITING FOR EVERYONE…</string>
    <string name="tally_together_ui_paused">PAUSED</string>
    <string name="tally_together_ui_playing">PLAYING</string>
    <string name="tally_together_ui_ended">YOU LEFT THE WATCH PARTY</string>

    <!-- Home row. Sentence case like Wholphin's home row titles; the count follows it. -->
    <string name="tally_together_ui_row_title">Watch parties</string>
    <string name="tally_together_ui_row_count">\u0020· %1$d</string>
    <string name="tally_together_ui_card_kicker">WATCH PARTY</string>
    <string name="tally_together_ui_key_ok">OK</string>
    <string name="tally_together_ui_join">Join</string>
    <string name="tally_together_ui_yours">YOU\'RE IN THIS WATCH PARTY</string>
    <string name="tally_together_ui_name_separator">" · "</string>
</resources>
