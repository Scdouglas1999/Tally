<resources>
    <!--
        JellyTV (Tally): Android 12+ shows a system splash (the launcher icon on the window background) before the
        app's first frame. That would show a lit amber icon before the launch card's dark lamp, so the splash is a
        plain ground-colored screen with a blank icon. Same parent and items as values/themes.xml otherwise.
    -->
    <style name="Theme.Wholphin" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:colorBackground">@android:color/background_dark</item>
        <item name="android:windowBackground">@color/jellytv_ground</item>
        <item name="android:windowSplashScreenBackground">@color/jellytv_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/jellytv_splash_blank</item>
    </style>

    <color name="jellytv_ground">#0E0F0E</color>
</resources>
